#!/usr/bin/env python3
"""
라즈베리파이 -> 아두이노 레이저 통신 송신 스크립트
UART TX 핀(GPIO14)에 연결된 레이저 송신 모듈을 통해 텍스트 파일 내용을 전송합니다.

sudo raspi-config
# Interface Options → Serial Port
#   "login shell over serial?" → No
#   "serial port hardware enabled?" → Yes
sudo reboot

# 확인
ls -l /dev/serial0

pip3 install pyserial --break-system-packages
"""

import serial
import time

SERIAL_PORT = '/dev/serial0'   # 안 되면 '/dev/ttyAMA0' 로 변경해서 시도
BAUD_RATE = 2400               # 아두이노 SoftwareSerial 설정값과 반드시 동일해야 함
FILE_PATH = '/home/pi/message.txt'
END_MARKER = '\n<<EOF>>\n'      # 아두이노 쪽 종료 마커와 일치해야 함


def send_file(path: str):
    with serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1) as ser:
        time.sleep(2)  # 포트 안정화 대기 (연결 직후 바로 쓰면 앞부분 유실될 수 있음)

        with open(path, 'r', encoding='utf-8') as f:
            content = f.read()

        payload = (content + END_MARKER).encode('utf-8')
        ser.write(payload)
        ser.flush()
        print(f"전송 완료: {len(content)}자, {len(payload)}바이트")


if __name__ == '__main__':
    send_file(FILE_PATH)